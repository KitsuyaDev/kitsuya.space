rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidTrack(data) {
      return data.keys().hasAll(['name', 'artist', 'album', 'image', 'url', 'updatedAt']) 
          && data.keys().size() == 6
          && data.name is string && data.name.size() <= 200
          && data.artist is string && data.artist.size() <= 200
          && data.album is string && data.album.size() <= 200
          && data.image is string && data.image.size() <= 1000
          && data.url is string && data.url.size() <= 1000
          && data.updatedAt == request.time;
    }

    match /status/{docId} {
      allow read: if true;
      
      allow create: if isValidTrack(incoming());
      
      allow update: if isValidTrack(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['name', 'artist', 'album', 'image', 'url', 'updatedAt']);
    }
  }
}
